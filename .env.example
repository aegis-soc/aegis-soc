# .env.example — 全部为占位值，复制为 .env 后务必修改
# 严禁把真实设备地址、账号口令、API Key 写入本文件或提交到仓库

# ---------- 应用 ----------
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO
TZ=Asia/Shanghai
BACKEND_PORT=8000
FRONTEND_PORT=8080

# ---------- MySQL 8 ----------
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=aegis_soc
MYSQL_USER=aegis
MYSQL_PASSWORD=change-me-db-password
MYSQL_PORT=3306
DATABASE_URL=mysql+pymysql://aegis:change-me-db-password@mysql:3306/aegis_soc?charset=utf8mb4

# ---------- Redis 7 ----------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---------- 认证与告警 ----------
JWT_SECRET=change-me-jwt-secret-at-least-32-characters-long
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
GRAYLOG_WEBHOOK_SECRET=change-me-graylog-webhook-secret
GRAYLOG_BEARER_TOKEN=
BOOTSTRAP_ADMIN_PASSWORD=Admin@123456

# ---------- 平台策略 ----------
GLOBAL_KILL_SWITCH=false
ALERT_DEDUPE_TTL=3600
ALERT_REPLAY_TOLERANCE=300
DEFAULT_BLOCK_DURATION=7200
TASK_MAX_RETRY=3
TASK_RETRY_BACKOFF=60
TASK_EAGER=false
MAX_BLOCK_PER_ALERT=20
